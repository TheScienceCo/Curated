# ---------------------------------------------------------------------------
# Job Intelligence Agent - example environment file
# Copy to `.env` and fill in real values. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
POSTGRES_USER=jia
POSTGRES_PASSWORD=jia_local_password
POSTGRES_DB=jia
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Full SQLAlchemy URL. If unset, it is assembled from the parts above.
DATABASE_URL=postgresql+psycopg://jia:jia_local_password@db:5432/jia

# --- LLM provider ---------------------------------------------------------
# One of: mock | anthropic | openai
# `mock` uses the deterministic rule-based extractor only and needs no API key.
# It is the default so the app (and CI) runs with zero credentials.
LLM_PROVIDER=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Embeddings are optional; when disabled résumé matching falls back to
# deterministic keyword/ontology overlap scoring.
EMBEDDINGS_ENABLED=false

# --- App ------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# Seed the database with the demo candidate profile + sample opportunities.
SEED_ON_STARTUP=true

# --- Frontend -------------------------------------------------------------
# Used by the Next.js app to reach the API from the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
